{
  "name": "cognisentry-safe-context",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Cognisentry AI: local CSV inspection, safe-context preparation, exact payload preview and local approval.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.web.json && vite build",
    "preview": "vite preview",
    "test": "node --import ./scripts/register-typescript.mjs scripts/test-suite.test.mjs",
    "demo:analyze": "node --import ./scripts/register-typescript.mjs scripts/analyze-sample.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
